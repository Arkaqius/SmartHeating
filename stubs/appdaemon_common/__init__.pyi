from collections.abc import Callable
from datetime import datetime as DateTime
from typing import TypeVar

_F = TypeVar("_F", bound=Callable[..., object])

def init_step(name: str, order: int = ...) -> Callable[[_F], _F]: ...

class HealthAppBase:
    args: dict[str, object]
    def initialize(self) -> None: ...
    def terminate(self) -> None: ...
    def get_state(self, entity: str, attribute: str = ...) -> object: ...
    def get_plugin_api(self, name: str) -> object: ...
    def call_service(self, service: str, **kwargs: object) -> object: ...
    def log(self, message: str, level: str = ...) -> None: ...
    def datetime(self) -> DateTime: ...
    def schedule_every(
        self, name: str, start_time: DateTime, interval: int, callback: Callable[..., object]
    ) -> object: ...
    def listen_event(
        self, callback: Callable[..., object], event: str, **kwargs: object
    ) -> object: ...
    def cancel_listen_event(self, handle: object) -> None: ...
    def enter_safe_state(
        self, reason: str, stop_timers: bool = ..., stop_listeners: bool = ...
    ) -> None: ...
    def start_heartbeat(self, interval_s: int = ...) -> None: ...
    def update_health_attrs(self, **attrs: object) -> None: ...
